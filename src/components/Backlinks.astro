---
import { getBacklinks } from "../lib/ots";

interface Props {
  targetId: string;
  chromeless?: boolean;
}

const { targetId, chromeless = false } = Astro.props;
const all = await getBacklinks();
const sources = all.get(targetId) ?? [];
const totalMentions = sources.reduce((acc, s) => acc + s.mentions.length, 0);
---
<div class:list={["backlinks", { "backlinks-chromeless": chromeless }]}>
  { !chromeless && (
    <div class="bl-header">
      <span>Linked mentions</span>
      <span class="bl-count">{totalMentions}</span>
    </div>
  ) }
  { sources.length === 0 ? (
    <div class="bl-empty">No linked mentions yet.</div>
  ) : (
    sources.map((s) => (
      <div class="bl-source">
        <a href={s.href} class="bl-source-title">
          <span class="bl-dot" style={`background:var(--color-ots-${s.type})`}></span>
          <span class="bl-source-name">{s.title}</span>
          <span class="bl-source-count">{s.mentions.length}</span>
        </a>
        {s.mentions.map((m) => (
          <div class="bl-mention">
            { m.kind === "frontmatter" ? (
              <>
                <span class="bl-field">{m.field}:</span>
                <span class="bl-hit">{m.label}</span>
              </>
            ) : m.kind === "preview" ? (
              <span class="bl-context">{m.text}</span>
            ) : (
              <>
                <span class="bl-context">{m.before}</span><span class="bl-hit">{m.label}</span><span class="bl-context">{m.after}</span>
              </>
            ) }
          </div>
        ))}
      </div>
    ))
  ) }
</div>
