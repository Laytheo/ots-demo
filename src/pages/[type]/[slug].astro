---
import Base from "../../layouts/Base.astro";
import CardCatalog from "../../components/CardCatalog.astro";
import LocalGraph from "../../components/LocalGraph";
import Backlinks from "../../components/Backlinks.astro";
import MobileAccordion from "../../components/MobileAccordion.astro";
import { getCollection, render } from "astro:content";
import { ROOT_TYPES, ROOT_COLOR, ROOT_LABEL, getBacklinks, getGraph, localGraph, type RootType } from "../../lib/ots";

export async function getStaticPaths() {
  const out: any[] = [];
  for (const t of ROOT_TYPES) {
    const c = await getCollection(t);
    for (const entry of c) {
      out.push({ params: { type: t, slug: entry.id }, props: { type: t, entry } });
    }
  }
  return out;
}

const { type, entry } = Astro.props as { type: RootType; entry: any };
const { Content } = await render(entry);
const fullGraph = await getGraph();
const local = localGraph(fullGraph, entry.id, 1);
const data = entry.data;
const allBacklinks = await getBacklinks();
const backlinkSources = allBacklinks.get(entry.id) ?? [];
const backlinkCount = backlinkSources.reduce((acc, s) => acc + s.mentions.length, 0);
const connectionCount = local.nodes.length - 1;
---
<Base title={`${data.title} — ${ROOT_LABEL[type]}`}>
  <div class="lg:hidden mb-6 space-y-3">
    <MobileAccordion label="Properties">
      <CardCatalog type={type} data={data} />
    </MobileAccordion>
    <MobileAccordion label="Backlinks" count={backlinkCount}>
      <Backlinks targetId={entry.id} />
    </MobileAccordion>
  </div>

  <section class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <aside class="lg:col-span-3 lg:order-1 hidden lg:block">
      <div class="lg:sticky lg:top-6">
        <CardCatalog type={type} data={data} />

        <div class="mt-6">
          <div class="font-mono uppercase text-[0.65rem] tracking-[0.18em] text-ink-muted mb-2">Local graph</div>
          <div class="border border-parchment-300 bg-parchment-50 p-1 rounded-sm">
            <LocalGraph client:only="react" graph={local} rootId={entry.id} height={260} />
          </div>
          <div class="font-mono text-[0.65rem] text-ink-faded mt-2 uppercase tracking-widest">{connectionCount} connection{connectionCount === 1 ? "" : "s"}</div>
        </div>
      </div>
    </aside>

    <article class="lg:col-span-6 lg:order-2">
      <div class="mb-3 font-mono uppercase text-[0.7rem] tracking-[0.18em] text-ink-muted">
        <a href={`/${type}`} class="hover:text-ink">/{type}</a>
        <span class="mx-1 text-ink-faded">/</span>
        <span>{entry.id}</span>
      </div>
      <h1 class="font-display italic text-4xl md:text-5xl mb-2 text-ink leading-[1.1]">{data.title}</h1>
      { type === "journal" && data.date && (
        <div class="font-mono uppercase text-[0.7rem] tracking-[0.18em] text-ink-muted mb-6">
          <span style={`color:${ROOT_COLOR.journal}`}>●</span> {data.date}{data.author ? ` · ${data.author}` : ""}
        </div>
      ) }
      { data.subtype && type !== "journal" && (
        <div class="font-mono uppercase text-[0.7rem] tracking-[0.18em] text-ink-muted mb-6">
          <span style={`color:${ROOT_COLOR[type]}`}>●</span> {String(data.subtype).replace(/\[\[|\]\]/g, "")}
        </div>
      ) }
      <div class="prose-body">
        <Content />
      </div>
    </article>

    <aside class="lg:col-span-3 lg:order-3 hidden lg:block">
      <div class="lg:sticky lg:top-6">
        <Backlinks targetId={entry.id} />
      </div>
    </aside>
  </section>

  <div class="lg:hidden mt-6">
    <MobileAccordion label="Local graph" count={connectionCount} open={true}>
      <div class="border border-parchment-300 bg-parchment-50 p-1 rounded-sm">
        <LocalGraph client:only="react" graph={local} rootId={entry.id} height={260} />
      </div>
    </MobileAccordion>
  </div>
</Base>
